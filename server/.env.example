# 复制成 server/.env（或直接 export）。没有的 key 对应功能自动降级，不会 500。
PORT=8787
ANTHROPIC_API_KEY=
# 2026-10-17 夜实测（每句含 TTS）：Opus 5.5 约 2.2 到 2.5 秒且 10 次里 4 次撞到 4 秒截止，Sonnet 5.5 约 1.4 到 2.0 秒。剧本关键句是后端模板，模型只负责分类。还嫌慢改 claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# TTS 首选 MiniMax，声音 Arrogant Miss（嚣张小姐，bright / bouncy / playful）。空 -> 退到 OpenAI；两者都空 -> audio_url 为 null，前端用 speechSynthesis
MINIMAX_API_KEY=
# 旧版账号需要 GroupId；新 key 一般不用，留空即可
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=Arrogant_Miss
# speech-02-turbo 最快；要更好音质改 speech-02-hd
MINIMAX_TTS_MODEL=speech-02-turbo
MINIMAX_TTS_SPEED=0.9
MINIMAX_LANGUAGE_BOOST=English
# 备用 TTS
OPENAI_API_KEY=
OPENAI_TTS_VOICE=sage
# STT；空 -> 只能键盘输入
DEEPGRAM_API_KEY=
# ngrok 地址，如 https://xxxx.ngrok-free.app；用于拼 audio_url
PUBLIC_BASE_URL=
DB_PATH=./trusttag.db
