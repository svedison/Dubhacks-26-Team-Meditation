# 复制成 server/.env（或直接 export）。没有的 key 对应功能自动降级，不会 500。
PORT=8787
ANTHROPIC_API_KEY=
# 延迟超 4 秒改 claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# TTS；空 -> audio_url 为 null，前端用 speechSynthesis
OPENAI_API_KEY=
OPENAI_TTS_VOICE=sage
# STT；空 -> 只能键盘输入
DEEPGRAM_API_KEY=
# ngrok 地址，如 https://xxxx.ngrok-free.app；用于拼 audio_url
PUBLIC_BASE_URL=
DB_PATH=./trusttag.db
